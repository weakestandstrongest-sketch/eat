# Google Places API (New) を有効にした API キー
# 未設定の場合はデモデータで動作します
GOOGLE_MAPS_API_KEY=

# 1 にするとキーがあってもデモデータを使います
DEMO=0

PORT=3000

# 使いすぎ防止: Google Places API の月間呼び出し回数の上限 (太平洋時間の月単位でリセット)
# 既定値は Google の毎月の無料枠。届く前に検索を止めます
MONTHLY_LIMIT_TEXT=5000
MONTHLY_LIMIT_NEARBY=1000
MONTHLY_LIMIT_DETAILS=1000
MONTHLY_LIMIT_PHOTO=1000

# 詳細画面の地図に Google マップの徒歩ルートを出すための Maps Embed API キー (無料・任意)
# ブラウザに渡るので、上のキーとは別に作り「Maps Embed API のみ」「HTTP リファラー制限」をかける
# 未設定なら OpenStreetMap の地図に出発地とお店を表示します
GOOGLE_MAPS_EMBED_KEY=
