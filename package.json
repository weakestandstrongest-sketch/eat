{
  "name": "eat",
  "version": "0.1.0",
  "description": "場所を入れると周辺の飲食店をジャンル別・評価付きで一覧表示するアプリ",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "deploy": "npm install --no-audit --no-fund && node scripts/deploy.js",
    "dev:worker": "wrangler dev",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "wrangler": "4.137.0"
  }
}
